# Copy to `.env` and fill in the key for whichever provider you are using.
# A real environment variable always wins over this file.

# --- The answering agent -----------------------------------------------------
# The only credential the harness needs. Nothing is copied from your own ~/.claude,
# and the key is passed to the container by name so it never reaches an argv.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: pin the model every condition runs on. Leaving it unset uses the CLI's
# own default, which means two runs of one condition may not be the same run.
# BENCHKIT_MODEL=claude-opus-5

# Optional: an Anthropic-compatible endpoint, to run the same conditions on another
# vendor. `BENCHKIT_MODEL` then names that vendor's model.
# BENCHKIT_BASE_URL=https://api.deepseek.com/anthropic

# --- The judge ---------------------------------------------------------------
# LiteLLM model name, used to verify each stated fact against the page the answer
# cited. Without it a run still scores everything checkable offline, and says so in
# its signals. A comparison must use one judge throughout.
# BENCHKIT_JUDGE_MODEL=deepseek/deepseek-flash
# BENCHKIT_JUDGE_API_KEY_ENV=DEEPSEEK_API_KEY
# BENCHKIT_JUDGE_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=
# BENCHKIT_JUDGE_EFFORT=low

# --- The corpus a benchmark measures against ---------------------------------
# Optional. A benchmark declares its own default, so these are only needed to point a
# run somewhere else — a local deployment, or a fork of the corpus.
# BENCHKIT_MCP_URL=https://mcp.nurok.ai/mcp
